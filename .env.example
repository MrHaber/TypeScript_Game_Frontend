FRONTEND_DOMAIN=game.example.com
FRONTEND_PORT=80

# For a unified domain, keep the API relative. Nginx proxies /api to backend.
VITE_API_URL=/api

# Add every browser origin that can call the backend directly.
# If frontend and backend are on the same domain through /api, this is mostly a fallback.
CORS_ORIGINS=https://game.example.com,http://game.example.com,http://127.0.0.1:5173,http://localhost:5173
